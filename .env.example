# ───────────────────────────────────────────────────────────────
# The QR Gate — env. Copy to .env.local and fill from the Supabase +
# Stripe + Resend dashboards. NEVER commit .env.local. In production,
# set these in the Vercel project's Environment Variables. Keys only
# here — never real values.
# ───────────────────────────────────────────────────────────────

# Public site URL — the FULL https origin, no trailing slash
# (e.g. https://www.theqrgate.com). Used for auth redirects, Stripe
# success/cancel URLs, OG, and sitemap. A malformed value falls back to
# the production domain (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=
# Public origin encoded into hosted QR codes (/q/[slug]) and tracked
# links (/r/[slug]). Falls back to NEXT_PUBLIC_SITE_URL, then localhost.
NEXT_PUBLIC_APP_URL=

# Supabase (this app's dedicated project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only — NEVER expose to the client

# Stripe (this app's dedicated account) — OPTIONAL. The free plan,
# auth, publishing, and analytics all work without these. Checkout is
# Stripe-HOSTED (server-side session → redirect), so no client Stripe.js.
STRIPE_SECRET_KEY=                  # server-only secret key
STRIPE_WEBHOOK_SECRET=              # server-only webhook signing secret
STRIPE_PRICE_PRO_MONTHLY=           # the $10/mo recurring Price id (server-only) — the ONLY price the server will charge
# NOT required by this app (hosted checkout uses no client-side Stripe.js).
# Leave blank unless you add a client Stripe.js flow later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics — server-only salt for the daily one-way visitor hash
# (approximate unique scans). Set a long random value in production.
ANALYTICS_HASH_SECRET=

# Resend (shared account, per-app API key) — OPTIONAL. Emails are
# silently skipped when unset; nothing else breaks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=                  # e.g. "The QR Gate <hello@yourdomain.com>"
